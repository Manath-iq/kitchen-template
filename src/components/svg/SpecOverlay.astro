---
/**
 * Полупрозрачная техкарта поверх фото кухни.
 * Слои разделены и подписаны для сигнатурной анимации сборки:
 * grid → dims → modules → hardware → callouts.
 *
 * Линии рисуются в два прохода — сначала светлый «ореол», сверху графит,
 * иначе разметка теряется на светлых участках фотографии.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={`ovl ${className}`}
  viewBox="0 0 1200 800"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  preserveAspectRatio="none"
>
  <defs>
    <pattern id="ovl-grid" width="50" height="50" patternUnits="userSpaceOnUse">
      <path d="M50 0H0V50" stroke="#F7F2EA" stroke-opacity="0.17" stroke-width="1" />
    </pattern>
    <marker id="ovl-arrow" markerWidth="9" markerHeight="9" refX="4.5" refY="4.5" orient="auto">
      <path d="M1 4.5 L8 1.8 L8 7.2 Z" fill="#F7F2EA" />
    </marker>
    <filter id="ovl-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="1" stdDeviation="2" flood-color="#2b2a28" flood-opacity="0.55" />
    </filter>
  </defs>

  <g filter="url(#ovl-shadow)">
    <!-- СЕТКА И РАМКА ЛИСТА -->
    <g class="ovl-layer" data-layer="grid">
      <rect x="26" y="26" width="1148" height="748" fill="url(#ovl-grid)" />
      <rect
        x="26"
        y="26"
        width="1148"
        height="748"
        stroke="#F7F2EA"
        stroke-opacity="0.45"
        stroke-dasharray="8 7"
      />
      <path d="M26 62 H1174" stroke="#F7F2EA" stroke-opacity="0.35" />
      <g class="ovl-tick" stroke="#F7F2EA" stroke-opacity="0.8" stroke-width="2">
        <path d="M26 60 V26 H60" /><path d="M1140 26 H1174 V60" />
        <path d="M26 740 V774 H60" /><path d="M1140 774 H1174 V740" />
      </g>
      <text x="44" y="52" class="ovl-mono" fill="#F7F2EA" fill-opacity="0.9">ЛИСТ ЗАМЕРА · К-01</text>
      <text x="1156" y="52" class="ovl-mono" text-anchor="end" fill="#F7F2EA" fill-opacity="0.75">М 1:20</text>
    </g>

    <!-- РАЗМЕРЫ -->
    <g class="ovl-layer" data-layer="dims">
      <path
        d="M120 120 H1080"
        stroke="#F7F2EA"
        stroke-opacity="0.9"
        marker-start="url(#ovl-arrow)"
        marker-end="url(#ovl-arrow)"
      />
      <path d="M120 104 V150" stroke="#F7F2EA" stroke-opacity="0.5" />
      <path d="M1080 104 V150" stroke="#F7F2EA" stroke-opacity="0.5" />
      <rect x="536" y="104" width="128" height="32" rx="8" fill="#F7F2EA" fill-opacity="0.94" />
      <text x="600" y="126" class="ovl-mono" text-anchor="middle" fill="#3A3835">3600 ММ</text>

      <path
        d="M1128 250 V700"
        stroke="#F7F2EA"
        stroke-opacity="0.9"
        marker-start="url(#ovl-arrow)"
        marker-end="url(#ovl-arrow)"
      />
      <rect x="1096" y="452" width="64" height="30" rx="8" fill="#F7F2EA" fill-opacity="0.94" />
      <text x="1128" y="473" class="ovl-mono" text-anchor="middle" fill="#3A3835">850</text>

      <path
        d="M72 190 V430"
        stroke="#F7F2EA"
        stroke-opacity="0.9"
        marker-start="url(#ovl-arrow)"
        marker-end="url(#ovl-arrow)"
      />
      <rect x="40" y="295" width="64" height="30" rx="8" fill="#F7F2EA" fill-opacity="0.94" />
      <text x="72" y="316" class="ovl-mono" text-anchor="middle" fill="#3A3835">720</text>
    </g>

    <!-- РАЗБИВКА НА МОДУЛИ -->
    <g class="ovl-layer" data-layer="modules" stroke="#F7F2EA" stroke-opacity="0.62" stroke-dasharray="7 6">
      <path d="M360 150 V700" /><path d="M600 150 V700" /><path d="M840 150 V700" />
      <path d="M120 430 H1080" />
    </g>

    <!-- ФУРНИТУРА -->
    <g class="ovl-layer" data-layer="hardware">
      <g stroke="#C3A26A" stroke-width="2.5" fill="none">
        <circle cx="360" cy="500" r="9" /><circle cx="600" cy="500" r="9" />
        <circle cx="840" cy="500" r="9" />
      </g>
      <g stroke="#C3A26A" stroke-opacity="0.7" stroke-dasharray="4 5">
        <path d="M360 500 H600" /><path d="M600 500 H840" />
      </g>
    </g>

    <!-- ВЫНОСКИ -->
    <g class="ovl-layer" data-layer="callouts">
      <g class="ovl-callout">
        <path d="M240 300 V640" stroke="#F7F2EA" stroke-opacity="0.6" stroke-dasharray="5 5" />
        <circle cx="240" cy="300" r="16" fill="#F7F2EA" fill-opacity="0.94" />
        <text x="240" y="306" class="ovl-mono" text-anchor="middle" fill="#3A3835">01</text>
        <rect x="150" y="646" width="180" height="34" rx="9" fill="#F7F2EA" fill-opacity="0.94" />
        <text x="240" y="668" class="ovl-mono" text-anchor="middle" fill="#3A3835">МДФ ФАСАД</text>
      </g>
      <g class="ovl-callout">
        <path d="M700 430 V640" stroke="#F7F2EA" stroke-opacity="0.6" stroke-dasharray="5 5" />
        <circle cx="700" cy="430" r="16" fill="#F7F2EA" fill-opacity="0.94" />
        <text x="700" y="436" class="ovl-mono" text-anchor="middle" fill="#3A3835">02</text>
        <rect x="610" y="646" width="180" height="34" rx="9" fill="#F7F2EA" fill-opacity="0.94" />
        <text x="700" y="668" class="ovl-mono" text-anchor="middle" fill="#3A3835">HPL 38 ММ</text>
      </g>
      <g class="ovl-callout">
        <path d="M960 500 V640" stroke="#F7F2EA" stroke-opacity="0.6" stroke-dasharray="5 5" />
        <circle cx="960" cy="500" r="16" fill="#F7F2EA" fill-opacity="0.94" />
        <text x="960" y="506" class="ovl-mono" text-anchor="middle" fill="#3A3835">03</text>
        <rect x="870" y="646" width="180" height="34" rx="9" fill="#F7F2EA" fill-opacity="0.94" />
        <text x="960" y="668" class="ovl-mono" text-anchor="middle" fill="#3A3835">ДОВОДЧИКИ</text>
      </g>
    </g>
  </g>
</svg>

<style>
  .ovl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  .ovl :global(.ovl-mono) {
    font-family: var(--font-data);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }
</style>
