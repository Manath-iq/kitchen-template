---
/**
 * Технический вид кухни в разрезе «фасад / элевация».
 * Слои разделены и подписаны для сигнатурной анимации сборки:
 * sheet → carcass → uppers → facades → hardware → top.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={`kspec ${className}`}
  viewBox="0 0 720 560"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Технический чертёж кухни: корпус, верхние модули, фасады, фурнитура и столешница с размерами"
>
  <defs>
    <pattern id="ks-grid" width="16" height="16" patternUnits="userSpaceOnUse">
      <path d="M16 0H0V16" stroke="#4B4B4B" stroke-opacity="0.09" stroke-width="1" />
    </pattern>
    <linearGradient id="ks-facade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E3D5BF" />
      <stop offset="1" stop-color="#D0BB9E" />
    </linearGradient>
    <linearGradient id="ks-facade-up" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EDE3D2" />
      <stop offset="1" stop-color="#DCCBB1" />
    </linearGradient>
    <linearGradient id="ks-top" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5A5A58" />
      <stop offset="1" stop-color="#3F3F3D" />
    </linearGradient>
    <marker id="ks-arrow" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
      <path d="M1 4 L7 1.6 L7 6.4 Z" fill="#4B4B4B" />
    </marker>
  </defs>

  <!-- ЛИСТ: рамка, сетка, штамп -->
  <g class="ks-layer" data-layer="sheet">
    <rect x="8" y="8" width="704" height="544" rx="14" fill="#FBF8F2" stroke="#4B4B4B" stroke-opacity="0.25" />
    <rect x="22" y="22" width="676" height="516" fill="url(#ks-grid)" />
    <rect x="22" y="22" width="676" height="516" stroke="#4B4B4B" stroke-opacity="0.35" stroke-dasharray="4 5" />
    <text x="36" y="46" class="ks-mono" fill="#8D6F3C">ЛИСТ ЗАМЕРА · К-01</text>
    <text x="684" y="46" class="ks-mono" text-anchor="end" fill="#5F5C55">М 1:20</text>
    <line x1="36" y1="56" x2="684" y2="56" stroke="#4B4B4B" stroke-opacity="0.2" />
  </g>

  <!-- РАЗМЕРЫ -->
  <g class="ks-layer" data-layer="dims">
    <line x1="80" y1="96" x2="620" y2="96" stroke="#4B4B4B" stroke-opacity="0.6" marker-start="url(#ks-arrow)" marker-end="url(#ks-arrow)" />
    <line x1="80" y1="88" x2="80" y2="132" stroke="#4B4B4B" stroke-opacity="0.35" />
    <line x1="620" y1="88" x2="620" y2="132" stroke="#4B4B4B" stroke-opacity="0.35" />
    <rect x="316" y="84" width="72" height="22" rx="6" fill="#FBF8F2" />
    <text x="352" y="99" class="ks-mono" text-anchor="middle" fill="#4B4B4B">3600 ММ</text>

    <line x1="656" y1="300" x2="656" y2="470" stroke="#4B4B4B" stroke-opacity="0.6" marker-start="url(#ks-arrow)" marker-end="url(#ks-arrow)" />
    <text x="668" y="392" class="ks-mono" text-anchor="middle" fill="#4B4B4B" transform="rotate(90 668 392)">850</text>

    <line x1="52" y1="132" x2="52" y2="276" stroke="#4B4B4B" stroke-opacity="0.6" marker-start="url(#ks-arrow)" marker-end="url(#ks-arrow)" />
    <text x="40" y="204" class="ks-mono" text-anchor="middle" fill="#4B4B4B" transform="rotate(-90 40 204)">720</text>
  </g>

  <!-- КОРПУС -->
  <g class="ks-layer" data-layer="carcass">
    <rect x="80" y="300" width="540" height="156" stroke="#4B4B4B" stroke-opacity="0.75" fill="#F2EDE4" />
    <rect x="88" y="456" width="524" height="14" fill="#4B4B4B" fill-opacity="0.14" stroke="#4B4B4B" stroke-opacity="0.4" />
    <g stroke="#4B4B4B" stroke-opacity="0.45" stroke-dasharray="5 4">
      <line x1="215" y1="300" x2="215" y2="456" />
      <line x1="350" y1="300" x2="350" y2="456" />
      <line x1="485" y1="300" x2="485" y2="456" />
      <line x1="80" y1="352" x2="620" y2="352" />
    </g>
    <line x1="40" y1="470" x2="680" y2="470" stroke="#4B4B4B" stroke-opacity="0.8" stroke-width="2" />
    <g stroke="#4B4B4B" stroke-opacity="0.3">
      <line x1="40" y1="470" x2="30" y2="482" /><line x1="80" y1="470" x2="70" y2="482" />
      <line x1="120" y1="470" x2="110" y2="482" /><line x1="160" y1="470" x2="150" y2="482" />
      <line x1="200" y1="470" x2="190" y2="482" /><line x1="240" y1="470" x2="230" y2="482" />
      <line x1="280" y1="470" x2="270" y2="482" /><line x1="320" y1="470" x2="310" y2="482" />
      <line x1="360" y1="470" x2="350" y2="482" /><line x1="400" y1="470" x2="390" y2="482" />
      <line x1="440" y1="470" x2="430" y2="482" /><line x1="480" y1="470" x2="470" y2="482" />
      <line x1="520" y1="470" x2="510" y2="482" /><line x1="560" y1="470" x2="550" y2="482" />
      <line x1="600" y1="470" x2="590" y2="482" /><line x1="640" y1="470" x2="630" y2="482" />
      <line x1="680" y1="470" x2="670" y2="482" />
    </g>
  </g>

  <!-- ВЕРХНИЕ МОДУЛИ -->
  <g class="ks-layer" data-layer="uppers">
    <rect x="80" y="132" width="270" height="144" stroke="#4B4B4B" stroke-opacity="0.7" fill="#F2EDE4" />
    <rect x="470" y="132" width="150" height="144" stroke="#4B4B4B" stroke-opacity="0.7" fill="#F2EDE4" />
    <path d="M362 276 L362 200 L458 200 L458 276" stroke="#4B4B4B" stroke-opacity="0.55" fill="#F2EDE4" />
    <path d="M380 200 L392 168 L428 168 L440 200" stroke="#4B4B4B" stroke-opacity="0.55" fill="#EFE9DE" />
    <text x="410" y="188" class="ks-mono ks-mono-sm" text-anchor="middle" fill="#5F5C55">ВЫТЯЖКА</text>
  </g>

  <!-- ФАСАДЫ -->
  <g class="ks-layer" data-layer="facades">
    <g class="ks-fac">
      <rect x="86" y="306" width="123" height="144" rx="3" fill="url(#ks-facade)" />
      <rect x="221" y="306" width="123" height="40" rx="3" fill="url(#ks-facade)" />
      <rect x="221" y="352" width="123" height="98" rx="3" fill="url(#ks-facade)" />
      <rect x="356" y="306" width="123" height="40" rx="3" fill="url(#ks-facade)" />
      <rect x="356" y="352" width="123" height="98" rx="3" fill="url(#ks-facade)" />
      <rect x="491" y="306" width="123" height="144" rx="3" fill="url(#ks-facade)" />
      <rect x="86" y="138" width="126" height="132" rx="3" fill="url(#ks-facade-up)" />
      <rect x="218" y="138" width="126" height="132" rx="3" fill="url(#ks-facade-up)" />
      <rect x="476" y="138" width="138" height="132" rx="3" fill="url(#ks-facade-up)" />
    </g>
    <g stroke="#8A7657" stroke-opacity="0.5" fill="none">
      <rect x="86" y="306" width="123" height="144" rx="3" />
      <rect x="221" y="306" width="123" height="40" rx="3" />
      <rect x="221" y="352" width="123" height="98" rx="3" />
      <rect x="356" y="306" width="123" height="40" rx="3" />
      <rect x="356" y="352" width="123" height="98" rx="3" />
      <rect x="491" y="306" width="123" height="144" rx="3" />
      <rect x="86" y="138" width="126" height="132" rx="3" />
      <rect x="218" y="138" width="126" height="132" rx="3" />
      <rect x="476" y="138" width="138" height="132" rx="3" />
    </g>
  </g>

  <!-- ФУРНИТУРА -->
  <g class="ks-layer" data-layer="hardware">
    <g fill="#C3A26A" stroke="#9E7F4C" stroke-opacity="0.7">
      <rect x="112" y="316" width="70" height="5" rx="2.5" />
      <rect x="247" y="316" width="70" height="5" rx="2.5" />
      <rect x="247" y="362" width="70" height="5" rx="2.5" />
      <rect x="382" y="316" width="70" height="5" rx="2.5" />
      <rect x="382" y="362" width="70" height="5" rx="2.5" />
      <rect x="517" y="316" width="70" height="5" rx="2.5" />
      <rect x="114" y="256" width="70" height="5" rx="2.5" />
      <rect x="246" y="256" width="70" height="5" rx="2.5" />
      <rect x="510" y="256" width="70" height="5" rx="2.5" />
    </g>
    <g stroke="#7C8F7A" stroke-width="1.5" fill="none">
      <circle cx="203" cy="150" r="4" /><circle cx="203" cy="258" r="4" />
      <circle cx="227" cy="150" r="4" /><circle cx="227" cy="258" r="4" />
    </g>
  </g>

  <!-- СТОЛЕШНИЦА + ФАРТУК -->
  <g class="ks-layer" data-layer="top">
    <rect x="74" y="284" width="552" height="18" rx="3" fill="url(#ks-top)" />
    <rect x="74" y="284" width="552" height="4" rx="2" fill="#8B8B87" fill-opacity="0.6" />
    <rect x="80" y="276" width="540" height="8" fill="#E8ECEF" stroke="#4B4B4B" stroke-opacity="0.25" />
    <ellipse cx="410" cy="292" rx="34" ry="7" fill="#2F2F2E" fill-opacity="0.5" />
    <path d="M410 292 L410 262 M400 262 L420 262" stroke="#C3A26A" stroke-width="2" fill="none" />
  </g>

  <!-- ВЫНОСКИ -->
  <g class="ks-layer" data-layer="callouts">
    <g class="ks-callout">
      <line x1="150" y1="212" x2="150" y2="512" stroke="#4B4B4B" stroke-opacity="0.35" stroke-dasharray="3 4" />
      <circle cx="150" cy="212" r="10" fill="#F7F2EA" stroke="#4B4B4B" stroke-opacity="0.6" />
      <text x="150" y="216" class="ks-mono ks-mono-sm" text-anchor="middle" fill="#4B4B4B">01</text>
      <text x="150" y="528" class="ks-mono ks-mono-sm" text-anchor="middle" fill="#5F5C55">МДФ ФАСАД</text>
    </g>
    <g class="ks-callout">
      <line x1="410" y1="292" x2="410" y2="512" stroke="#4B4B4B" stroke-opacity="0.35" stroke-dasharray="3 4" />
      <circle cx="410" cy="292" r="10" fill="#F7F2EA" stroke="#4B4B4B" stroke-opacity="0.6" />
      <text x="410" y="296" class="ks-mono ks-mono-sm" text-anchor="middle" fill="#4B4B4B">02</text>
      <text x="410" y="528" class="ks-mono ks-mono-sm" text-anchor="middle" fill="#5F5C55">HPL 38 ММ</text>
    </g>
    <g class="ks-callout">
      <line x1="552" y1="318" x2="552" y2="512" stroke="#4B4B4B" stroke-opacity="0.35" stroke-dasharray="3 4" />
      <circle cx="552" cy="318" r="10" fill="#F7F2EA" stroke="#4B4B4B" stroke-opacity="0.6" />
      <text x="552" y="322" class="ks-mono ks-mono-sm" text-anchor="middle" fill="#4B4B4B">03</text>
      <text x="552" y="528" class="ks-mono ks-mono-sm" text-anchor="middle" fill="#5F5C55">ДОВОДЧИКИ</text>
    </g>
  </g>
</svg>

<style>
  .kspec {
    width: 100%;
    height: auto;
    display: block;
  }

  .kspec :global(.ks-mono) {
    font-family: var(--font-data);
    font-size: 12px;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .kspec :global(.ks-mono-sm) {
    font-size: 10px;
  }
</style>
