---
import { waDefault } from '../lib/waMessage';
---

<div class="mbar" data-mbar>
  <a class="btn btn-primary btn-sm mbar__btn" href="#quiz" data-goal="hero_cta_click">Рассчитать кухню</a>
  <a
    class="btn btn-wa btn-sm mbar__wa"
    href={waDefault}
    target="_blank"
    rel="noopener"
    aria-label="Написать в WhatsApp"
    data-goal="wa_click_hero"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"/>
    </svg>
  </a>
</div>

<style>
  .mbar {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 70;
    display: flex;
    gap: 8px;
    padding: 8px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px -26px rgba(75, 75, 75, 0.9);
    translate: 0 140%;
    transition: translate 0.35s var(--ease-out);
  }

  .mbar[data-visible='true'] {
    translate: 0 0;
  }

  .mbar__btn {
    flex: 1;
  }

  .mbar__wa {
    width: 52px;
    flex: none;
    padding: 0;
  }

  @media (min-width: 900px) {
    .mbar {
      display: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  if (bar) {
    let ticking = false;
    const update = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const past = window.scrollY > window.innerHeight * 0.6;
        const footer = document.querySelector('.ftr');
        const nearFooter = footer
          ? footer.getBoundingClientRect().top < window.innerHeight - 40
          : false;
        bar.setAttribute('data-visible', String(past && !nearFooter));
        ticking = false;
      });
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>
