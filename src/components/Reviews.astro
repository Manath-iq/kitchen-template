---
import { clientConfig } from '../config/client';
import SheetHead from './ui/SheetHead.astro';

const c = clientConfig;
---

<section class="section" id="reviews">
  <div class="container">
    <SheetHead sheet="ЛИСТ 09" label="ОТЗЫВЫ" index="09 / 11" />

    <div class="rev__intro">
      <h2 class="h2" data-anim="rise">Что пишут в картах</h2>
      <p class="lead" data-anim="fade">
        Отзывы с указанием источника. Мы не редактируем текст и не убираем неудобные детали.
      </p>
    </div>

    <div class="rev">
      {c.reviews.map((review, i) => (
        <figure class="rev__card paper" data-anim="rise" style={`--i:${i}`}>
          <div class="rev__head">
            <span class={`rev__source rev__source--${review.source === '2ГИС' ? 'gis' : 'ya'}`}>
              {review.source}
            </span>
            <span class="rev__stars" aria-label={`Оценка ${review.rating} из 5`}>
              {Array.from({ length: 5 }).map((_, s) => (
                <svg width="13" height="13" viewBox="0 0 16 16" fill={s < review.rating ? '#C3A26A' : 'none'} stroke="#C3A26A" stroke-opacity="0.6" aria-hidden="true">
                  <path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4l-3.8 2 .7-4.3-3.1-3 4.3-.6L8 1.6Z" stroke-width="1"/>
                </svg>
              ))}
            </span>
          </div>

          <blockquote class="rev__text">«{review.text}»</blockquote>

          <figcaption class="rev__foot">
            <span class="rev__author">{review.author}</span>
            <span class="tag">{review.date}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="rev__foot-row">
      <a class="btn btn-ghost" href={c.twoGisUrl} target="_blank" rel="noopener">Показать больше отзывов</a>
      <p class="tag rev__note">Демо-карточки. В боевой версии подставляются скриншоты и ссылки на карточки компании.</p>
    </div>
  </div>
</section>

<style>
  .rev__intro {
    display: grid;
    gap: 14px;
    max-width: 60ch;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .rev {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .rev__card {
    padding: 22px;
    display: grid;
    gap: 14px;
    align-content: start;
    rotate: -0.35deg;
  }

  .rev__card:nth-child(2n) {
    rotate: 0.4deg;
  }

  .rev__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .rev__source {
    font-family: var(--font-data);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    padding: 5px 10px;
    border-radius: 7px;
    border: 1px solid var(--line);
  }

  .rev__source--gis {
    background: rgba(124, 143, 122, 0.16);
    color: #55684f;
  }

  .rev__source--ya {
    background: rgba(165, 94, 71, 0.14);
    color: var(--color-rust);
  }

  .rev__stars {
    display: inline-flex;
    gap: 2px;
  }

  .rev__text {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .rev__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
  }

  .rev__author {
    font-weight: 500;
  }

  .rev__foot-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  .rev__note {
    text-transform: none;
    letter-spacing: 0.03em;
    max-width: 50ch;
    opacity: 0.8;
  }
</style>
