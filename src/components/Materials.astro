---
import { clientConfig } from '../config/client';
import SheetHead from './ui/SheetHead.astro';

const materials = clientConfig.materials;
---

<section class="section" id="materials">
  <div class="container">
    <SheetHead sheet="ЛИСТ 06" label="МАТЕРИАЛЫ" index="06 / 11" />

    <div class="mat__intro">
      <h2 class="h2" data-anim="rise">Из чего собрана цена</h2>
      <p class="lead" data-anim="fade">
        Стоимость кухни — это плита, кромка, фурнитура и столешница. Разница между «дёшево»
        и «надолго» почти всегда прячется в этих шести строках.
      </p>
    </div>

    <div class="mat">
      {materials.map((item, i) => (
        <article class="mat__card paper" data-anim="rise" style={`--i:${i}`}>
          <div class={`mat__swatch mat__swatch--${item.swatch}`} aria-hidden="true">
            <span class="num mat__code">{item.code}</span>
          </div>
          <div class="mat__body">
            <h3 class="mat__title">{item.title}</h3>
            <p class="mat__desc">{item.description}</p>
            <p class="tag mat__note">{item.note}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="mat__foot">
      <a class="btn btn-primary" href="#calculator" data-goal="calculator_open">Собрать комплектацию</a>
      <p class="tag mat__foot-note">
        Комплектация меняет итог сильнее, чем длина. Проверьте в калькуляторе.
      </p>
    </div>
  </div>
</section>

<style>
  .mat__intro {
    display: grid;
    gap: 14px;
    max-width: 62ch;
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  /* сетка 3×2 по спеке — шесть образцов как одна выкладка материалов */
  .mat {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  @media (min-width: 1024px) {
    .mat {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .mat__card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s var(--ease-out);
  }

  .mat__card:hover {
    transform: translateY(-4px);
  }

  .mat__swatch {
    position: relative;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--line);
  }

  .mat__code {
    position: absolute;
    top: 12px;
    left: 14px;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(247, 242, 234, 0.86);
    color: var(--color-muted);
  }

  /* ЛДСП: тёплая плита с волокном */
  .mat__swatch--ldsp {
    background:
      repeating-linear-gradient(92deg, rgba(122, 96, 60, 0.14) 0 2px, transparent 2px 9px),
      linear-gradient(160deg, #ddc9ab, #c9b193);
  }

  /* МДФ: матовая крашеная поверхность */
  .mat__swatch--mdf {
    background:
      radial-gradient(120% 90% at 20% 10%, rgba(255, 255, 255, 0.5), transparent 60%),
      linear-gradient(160deg, #e6e2da, #cfcac0);
  }

  /* Столешница HPL: тёмный камень с крапом */
  .mat__swatch--top {
    background:
      radial-gradient(2px 2px at 20% 30%, rgba(255, 255, 255, 0.4), transparent 60%),
      radial-gradient(2px 2px at 62% 68%, rgba(255, 255, 255, 0.3), transparent 60%),
      radial-gradient(1.5px 1.5px at 80% 22%, rgba(255, 255, 255, 0.35), transparent 60%),
      radial-gradient(1.5px 1.5px at 38% 78%, rgba(255, 255, 255, 0.25), transparent 60%),
      linear-gradient(160deg, #57565a, #3e3d41);
  }

  .mat__swatch--top .mat__code {
    background: rgba(247, 242, 234, 0.9);
  }

  /* Фурнитура: латунь/сталь */
  .mat__swatch--hinge {
    background:
      linear-gradient(100deg, rgba(255, 255, 255, 0.5) 0 12%, transparent 12% 24%,
        rgba(255, 255, 255, 0.32) 24% 33%, transparent 33% 52%,
        rgba(255, 255, 255, 0.4) 52% 60%, transparent 60%),
      linear-gradient(160deg, #d3b47c, #a98a56);
  }

  /* Кромка ПВХ: узкая полоса на торце */
  .mat__swatch--edge {
    background:
      linear-gradient(to bottom, #d9c7ae 0 46%, #8a7657 46% 54%, #ddcdb6 54%),
      #d9c7ae;
  }

  /* Наполнение: перфорация и направляющие */
  .mat__swatch--extras {
    background:
      repeating-linear-gradient(90deg, rgba(75, 75, 75, 0.16) 0 1px, transparent 1px 22px),
      repeating-linear-gradient(0deg, rgba(75, 75, 75, 0.12) 0 1px, transparent 1px 22px),
      linear-gradient(160deg, #e8ecef, #d6dce1);
  }

  .mat__body {
    padding: 18px 20px 20px;
    display: grid;
    gap: 6px;
    align-content: start;
    flex: 1;
  }

  .mat__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
  }

  .mat__desc {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .mat__note {
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    opacity: 0.75;
    transition: opacity 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .mat__card:hover .mat__note {
    opacity: 1;
    color: #8d6f3c;
  }

  .mat__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }

  .mat__foot-note {
    text-transform: none;
    letter-spacing: 0.03em;
    max-width: 44ch;
  }
</style>
