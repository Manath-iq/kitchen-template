---
import { clientConfig } from '../config/client';
import { formatRub } from '../lib/format';
import SheetHead from './ui/SheetHead.astro';

const c = clientConfig;

const sizes = [
  { id: 's24', label: 'Кухня 2,4 м', meta: 'ПРЯМАЯ / 2,4 М', base: c.pricing.price24m },
  { id: 's3', label: 'Кухня 3 м', meta: 'УГЛОВАЯ / 3 М', base: c.pricing.price3m },
  { id: 's4', label: 'Кухня 4 м', meta: 'УГЛОВАЯ / 4 М', base: c.pricing.price4m },
];
---

<section class="section" id="prices">
  <div class="container">
    <SheetHead sheet="ЛИСТ 10" label="ЦЕНЫ" index="10 / 11" />

    <div class="price__intro">
      <div>
        <h2 class="h2" data-anim="rise">Сколько это стоит</h2>
        <p class="lead" data-anim="fade">
          Три типовых сценария. Переключатель меняет комплектацию — видно, за что именно
          растёт цена.
        </p>
      </div>

      <div class="price__switch" role="group" aria-label="Уровень комплектации" data-price-switch>
        {c.tiers.map((tier, i) => (
          <button
            type="button"
            class="price__switch-btn"
            data-tier={tier.id}
            data-coeff={tier.coeff}
            aria-pressed={i === 1 ? 'true' : 'false'}
          >
            {tier.label}
          </button>
        ))}
      </div>
    </div>

    <div class="price">
      {sizes.map((size, i) => (
        <article class={`price__card paper ticks ${i === 1 ? 'price__card--hi' : ''}`} data-anim="rise" style={`--i:${i}`}>
          <div class="price__head">
            <span class="tag">{size.meta}</span>
            {i === 1 && <span class="tag price__pick">ЧАЩЕ ВСЕГО</span>}
          </div>

          <h3 class="h3 price__title">{size.label}</h3>

          <p class="price__value num">
            <span class="price__from">от</span>
            <span data-price-value data-base={size.base}>{formatRub(Math.round(size.base * 1.26))}</span>
          </p>

          <ul class="price__list" data-price-included></ul>

          <p class="tag price__extra">
            Дополнительно: <span data-price-extra></span>
          </p>

          <a class="btn btn-ghost btn-block price__cta" href="#calculator" data-goal="calculator_open">
            Проверить мой бюджет
          </a>
        </article>
      ))}
    </div>

    <p class="tag price__note">{c.disclaimers.priceNote} {c.disclaimers.publicOffer}</p>
  </div>
</section>

<style>
  .price__intro {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .price__intro > div:first-child {
    display: grid;
    gap: 14px;
    max-width: 60ch;
  }

  .price__switch {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    border-radius: var(--radius-btn);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.6);
    align-self: end;
    flex-wrap: wrap;
  }

  .price__switch-btn {
    min-height: 44px;
    padding: 10px 18px;
    border: 0;
    border-radius: 14px;
    background: transparent;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-muted);
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .price__switch-btn[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .price {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .price__card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .price__card--hi {
    border-color: rgba(195, 162, 106, 0.7);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 18px 40px -30px rgba(75, 75, 75, 0.8);
  }

  .price__head {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
  }

  .price__pick {
    color: var(--color-brass-text);
  }

  .price__value {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .price__from {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-rust-text);
    font-family: var(--font-body);
  }

  .price__list {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
    display: grid;
    gap: 7px;
    font-size: 0.93rem;
    color: var(--color-muted);
  }

  .price__list li {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .price__list li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-green);
    flex: none;
    translate: 0 -2px;
  }

  .price__extra {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .price__cta {
    margin-top: 4px;
  }

  .price__note {
    margin-top: 20px;
    text-transform: none;
    letter-spacing: 0.03em;
    max-width: 76ch;
    opacity: 0.85;
  }

  @media (min-width: 900px) {
    .price__intro {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
</style>

<script>
  import { clientConfig } from '../config/client';
  import { formatRub } from '../lib/format';

  const wrap = document.querySelector<HTMLElement>('#prices');
  const group = document.querySelector<HTMLElement>('[data-price-switch]');

  if (wrap && group) {
    const apply = (tierId: string) => {
      const tier = clientConfig.tiers.find((t) => t.id === tierId) ?? clientConfig.tiers[1]!;

      wrap.querySelectorAll<HTMLElement>('[data-price-value]').forEach((el) => {
        const base = Number(el.dataset.base ?? 0);
        el.textContent = formatRub(Math.round((base * tier.coeff) / 1000) * 1000);
      });

      wrap.querySelectorAll<HTMLElement>('[data-price-included]').forEach((el) => {
        el.innerHTML = tier.included.map((line) => `<li>${line}</li>`).join('');
      });

      wrap.querySelectorAll<HTMLElement>('[data-price-extra]').forEach((el) => {
        el.textContent = tier.extra.join(', ').toLowerCase();
      });
    };

    group.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.price__switch-btn');
      if (!button) return;
      group.querySelectorAll<HTMLElement>('.price__switch-btn').forEach((el) => {
        el.setAttribute('aria-pressed', String(el === button));
      });
      apply(button.dataset.tier ?? 'standard');
    });

    apply('standard');
  }
</script>
