---
import { clientConfig } from '../config/client';
import { waDefault } from '../lib/waMessage';

const c = clientConfig;
---

<section class="section" id="final">
  <div class="container">
    <div class="final paper paper-ink ticks">
      <div class="final__grid">
        <div>
          <span class="tag">СЛЕДУЮЩИЙ ШАГ</span>
          <h2 class="h2 final__title">Получите ваш вариант кухни с ценой и сроком</h2>
          <p class="final__lead">
            Покажем комплектацию, бюджет и следующий шаг в WhatsApp. Без звонка, без обязательств
            и без «пришлите планировку, потом посчитаем».
          </p>

          <div class="final__actions">
            <a class="btn btn-brass" href="#quiz" data-goal="hero_cta_click">Рассчитать кухню</a>
            <a class="btn btn-wa" href={waDefault} target="_blank" rel="noopener" data-goal="wa_click_result">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"/>
              </svg>
              Написать в WhatsApp
            </a>
          </div>

          <p class="tag final__pdn">{c.disclaimers.pdn}</p>
        </div>

        <dl class="final__facts">
          <div>
            <dt class="tag">ЗАМЕР</dt>
            <dd class="num">до {c.trust.measureHours} часов</dd>
          </div>
          <div>
            <dt class="tag">СРОК</dt>
            <dd class="num">{c.leadTimeText}</dd>
          </div>
          <div>
            <dt class="tag">ГАРАНТИЯ</dt>
            <dd class="num">{c.warranty} · фурнитура {c.warrantyFurniture}</dd>
          </div>
          <div>
            <dt class="tag">ПРЕДОПЛАТА</dt>
            <dd class="num">{c.prepayment}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    padding: clamp(26px, 4vw, 52px);
  }

  .final__grid {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  .final__title {
    margin: 12px 0 14px;
    color: var(--color-paper);
    font-size: clamp(1.7rem, 3.4vw, 3rem);
  }

  .final__lead {
    color: rgba(247, 242, 234, 0.78);
    max-width: 54ch;
    margin-bottom: 24px;
  }

  .final__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
  }

  .final__pdn {
    text-transform: none;
    letter-spacing: 0.03em;
    color: rgba(247, 242, 234, 0.6);
    line-height: 1.55;
    max-width: 60ch;
    font-size: 0.72rem;
  }

  .final__facts {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 20px;
    border-radius: var(--radius-input);
    background: rgba(247, 242, 234, 0.08);
    border: 1px solid rgba(247, 242, 234, 0.16);
  }

  .final__facts > div {
    display: grid;
    gap: 3px;
    padding-bottom: 12px;
    border-bottom: 1px dashed rgba(247, 242, 234, 0.2);
  }

  .final__facts > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .final__facts dd {
    margin: 0;
    color: var(--color-paper);
    font-size: 0.98rem;
  }

  @media (min-width: 900px) {
    .final__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
      gap: 44px;
    }
  }
</style>
