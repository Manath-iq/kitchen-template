---
import { clientConfig } from '../config/client';
import { plural } from '../lib/format';
import SheetHead from './ui/SheetHead.astro';

const t = clientConfig.trust;

const stats = [
  { value: String(t.yearsOnMarket), unit: plural(t.yearsOnMarket, ['год', 'года', 'лет']), label: 'НА РЫНКЕ', note: 'работаем с 2015 года' },
  { value: String(t.kitchensPerMonth), unit: 'кухонь', label: 'В ПРОИЗВОДСТВЕ', note: 'ежемесячно, без очереди на месяцы' },
  { value: String(t.warrantyYears), unit: plural(t.warrantyYears, ['год', 'года', 'лет']), label: 'ГАРАНТИЯ', note: 'на корпус и сборку' },
  { value: `${t.measureHours} ч`, unit: '', label: 'ЗАМЕР', note: 'выезд в течение суток' },
  { value: `${t.installDays}`, unit: plural(t.installDays, ['день', 'дня', 'дней']), label: 'МОНТАЖ', note: 'типовая кухня под ключ' },
];
---

<section class="section section-tight" id="trust">
  <div class="container">
    <SheetHead sheet="ЛИСТ 01" label="ПОДТВЕРЖДЕНИЯ" index="01 / 11" />

    <div class="trust">
      {stats.map((s, i) => (
        <article class="trust__card paper" data-anim="rise" style={`--i:${i}`}>
          <span class="tag">{s.label}</span>
          <p class="trust__value num">
            {s.value}
            {s.unit && <span class="trust__unit"> {s.unit}</span>}
          </p>
          <p class="trust__note">{s.note}</p>
        </article>
      ))}

      <article class="trust__card trust__card--doc paper paper-cool" data-anim="rise" style="--i:5">
        <span class="tag">ДОКУМЕНТЫ</span>
        <p class="trust__doc-title">{t.contractNote}</p>
        <svg viewBox="0 0 220 86" class="trust__doc" fill="none" aria-hidden="true">
          <rect x="0.5" y="0.5" width="146" height="85" rx="6" fill="#FBF8F2" stroke="#4B4B4B" stroke-opacity="0.3"/>
          <g stroke="#4B4B4B" stroke-opacity="0.35">
            <line x1="14" y1="18" x2="90" y2="18"/><line x1="14" y1="30" x2="132" y2="30"/>
            <line x1="14" y1="42" x2="132" y2="42"/><line x1="14" y1="54" x2="104" y2="54"/>
          </g>
          <rect x="14" y="62" width="52" height="12" rx="3" fill="#7C8F7A" fill-opacity="0.3"/>
          <path d="M96 70c8-14 14-6 20-14" stroke="#4B4B4B" stroke-width="1.5"/>
          <rect x="156" y="12" width="60" height="60" rx="30" stroke="#A55E47" stroke-opacity="0.55" stroke-dasharray="4 4"/>
          <text x="186" y="38" text-anchor="middle" fill="#A55E47" font-size="10" font-family="var(--font-data)">ТР ТС</text>
          <text x="186" y="52" text-anchor="middle" fill="#A55E47" font-size="10" font-family="var(--font-data)">025/2012</text>
        </svg>
        <p class="trust__note">{clientConfig.disclaimers.techReg}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .trust__card {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .trust__value {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .trust__unit {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .trust__note {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: auto;
  }

  .trust__card--doc {
    grid-column: span 2;
  }

  .trust__doc-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .trust__doc {
    width: 100%;
    max-width: 240px;
    height: auto;
    margin-block: 8px;
  }

  @media (min-width: 720px) {
    .trust {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .trust__card--doc {
      grid-column: span 3;
      flex-direction: row;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }
    .trust__card--doc .trust__note {
      flex: 1 1 260px;
      margin-top: 0;
    }
  }

  @media (min-width: 1100px) {
    .trust {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .trust__card--doc {
      grid-column: span 5;
    }
  }
</style>
