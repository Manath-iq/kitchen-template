---
import { clientConfig } from '../config/client';
import { waMeasure } from '../lib/waMessage';
import SheetHead from './ui/SheetHead.astro';

const c = clientConfig;
const tel = c.phone.replace(/[^\d+]/g, '');
---

<section class="section" id="contacts">
  <div class="container">
    <SheetHead sheet="ЛИСТ 08" label="АДРЕС" index="08 / 11" />

    <div class="loc">
      <div class="loc__card paper ticks">
        <span class="tag tag-brass">САЛОН И ПРОИЗВОДСТВО</span>
        <h2 class="h2 loc__title">{c.companyName}</h2>

        <dl class="loc__list">
          <div>
            <dt class="tag">АДРЕС</dt>
            <dd>{c.city}, {c.address}</dd>
          </div>
          <div>
            <dt class="tag">ГРАФИК</dt>
            <dd>{c.hours}</dd>
          </div>
          <div>
            <dt class="tag">ТЕЛЕФОН</dt>
            <dd><a class="loc__link num" href={`tel:${tel}`} data-goal="phone_click">{c.phone}</a></dd>
          </div>
          <div>
            <dt class="tag">РЕГИОН РАБОТ</dt>
            <dd>{c.city} и {c.region}</dd>
          </div>
        </dl>

        <div class="loc__actions">
          <a class="btn btn-primary" href={waMeasure} target="_blank" rel="noopener" data-goal="wa_click_result">
            Заехать на замер
          </a>
          <a class="btn btn-ghost" href={c.routeUrl} target="_blank" rel="noopener" data-goal="map_open">
            Построить маршрут
          </a>
        </div>

        <p class="tag loc__note">
          Замер бесплатный в границах города. За городом — по договорённости, стоимость видна
          до выезда.
        </p>
      </div>

      <div class="loc__map paper">
        <div class="loc__map-frame">
          <iframe
            src={c.mapEmbedUrl}
            title={`Карта: ${c.companyName}, ${c.city}, ${c.address}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
        <div class="loc__map-bar">
          <span class="tag">{c.city.toUpperCase()} · {c.address.toUpperCase()}</span>
          <a class="link-brass" href={c.mapUrl} target="_blank" rel="noopener" data-goal="map_open">
            Открыть в карте
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .loc {
    display: grid;
    gap: 14px;
    align-items: stretch;
  }

  .loc__card {
    padding: clamp(22px, 3vw, 34px);
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .loc__title {
    font-size: clamp(1.7rem, 3vw, 2.6rem);
  }

  .loc__list {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .loc__list > div {
    display: grid;
    gap: 2px;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--line);
  }

  .loc__list dd {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 500;
  }

  .loc__link {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-brass);
  }

  .loc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .loc__note {
    text-transform: none;
    letter-spacing: 0.03em;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .loc__map {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .loc__map-frame {
    position: relative;
    flex: 1;
    min-height: 320px;
  }

  .loc__map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: saturate(0.78) contrast(1.02);
  }

  .loc__map-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border-top: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.6);
  }

  @media (min-width: 900px) {
    .loc {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }
</style>
