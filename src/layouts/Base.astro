---
import '../styles/global.css';
import { clientConfig } from '../config/client';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Микроразметка страницы (FAQPage, Product и т.п.) */
  schema?: unknown[];
}

const { title, description, schema = [] } = Astro.props;
const c = clientConfig;

/**
 * @font-face живёт здесь, а не в global.css: путям нужен BASE_URL,
 * иначе на GitHub Pages (сайт в подпапке) шрифты уезжают в 404.
 */
const cyrillic = 'U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116';
const latin =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';

const faces = [
  { family: 'Onest', file: 'onest', weight: '300 900' },
  { family: 'Unbounded', file: 'unbounded', weight: '200 900' },
  { family: 'JetBrains Mono', file: 'jetbrains-mono', weight: '100 800' },
];

const fontCss = faces
  .flatMap((face) =>
    (
      [
        ['cyrillic', cyrillic],
        ['latin', latin],
      ] as const
    ).map(
      ([subset, range]) => `@font-face{font-family:'${face.family}';font-style:normal;
font-display:swap;font-weight:${face.weight};
src:url('${withBase(`/fonts/${face.file}-${subset}-wght-normal.woff2`)}') format('woff2-variations');
unicode-range:${range};}`,
    ),
  )
  .join('\n');
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;

/**
 * Микроразметка настоящего бизнеса — только когда бизнес настоящий.
 * В демо-режиме адрес, телефон и часы работы это заглушки, и отдавать их
 * поисковику как LocalBusiness нельзя: он ставит такие карточки в локальную
 * выдачу, и человек приходит по адресу, которого не существует.
 */
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: c.companyName,
  description: `Кухни на заказ в ${c.cityPrepositional}: замер, проект, производство и монтаж.`,
  telephone: c.phone,
  url: canonical,
  address: {
    '@type': 'PostalAddress',
    addressLocality: c.city,
    addressRegion: c.region,
    streetAddress: c.address,
    addressCountry: 'RU',
  },
  openingHours: c.hours,
  priceRange: '₽₽',
  areaServed: c.region,
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      /* Демо закрыто от индексации: оно не должно занимать выдачу по
         коммерческим запросам вместо настоящих мастерских. follow, а не
         nofollow, — ссылка на автора в подвале должна работать.
         Под живого клиента demoMode выключается, и страница индексируется. */
      c.demoMode && <meta name="robots" content="noindex, follow" />
    }
    <meta name="theme-color" content="#F7F2EA" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <link rel="icon" href={withBase('/brand/favicon.svg')} type="image/svg+xml" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase('/fonts/onest-cyrillic-wght-normal.woff2')}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase('/fonts/onest-latin-wght-normal.woff2')}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase('/fonts/unbounded-cyrillic-wght-normal.woff2')}
      crossorigin
    />

    <style set:html={fontCss} is:inline></style>

    <script is:inline>
      // Блокирующий и крошечный: решает до первой отрисовки, анимируем мы или нет.
      // Если motion-модуль не поднялся за 2.5 c — принудительно показываем всё.
      (function () {
        var root = document.documentElement;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.classList.add(reduced ? 'no-motion' : 'is-motion');
        if (!reduced) {
          setTimeout(function () {
            if (!root.classList.contains('is-ready')) {
              root.classList.remove('is-motion');
              root.classList.add('no-motion');
            }
          }, 2500);
        }
      })();
    </script>

    {
      !c.demoMode && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(localBusiness)}
          is:inline
        />
      )
    }
    {
      schema.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} is:inline />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip">Перейти к содержимому</a>
    <slot />
  </body>
</html>
